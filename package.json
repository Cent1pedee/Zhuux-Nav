{
  "name": "universe-nav",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "description": "面向技术从业者的导航页 —— Next.js + TypeScript + Tailwind CSS 静态站点",
  "scripts": {
    "prepare:data": "node scripts/sync-data.mjs",
    "dev": "pnpm run prepare:data && next dev -p 4321",
    "build": "pnpm run validate:data && pnpm run prepare:data && next build",
    "preview": "node scripts/serve-out.mjs 4321",
    "start": "pnpm run preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:data": "node scripts/validate-data.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "pnpm run validate:data && pnpm run typecheck && pnpm run test:e2e",
    "check": "pnpm run validate:data && pnpm run typecheck && pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "motion": "^14.6.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "not dead"
  ]
}
